<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite" parallel="tests">
	<listeners>
		<listener
			class-name="selenium.learning.framework.testComponents.Listeners" />
	</listeners>
	<test thread-count="5" name="submitOrder">
		<classes>
			<class name="selenium.learning.framework.tests.SubmitOrderTest" />
		</classes>
	</test> <!-- Test -->
	<test name="errorValidations" thread-count="5">
		<classes>
			<class
				name="selenium.learning.framework.tests.ErrorValidations" />
		</classes>
	</test>
</suite> <!-- Suite -->
